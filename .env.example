# Cloudflare R2 public asset base URL — no trailing slash.
#
# Consumed by src/config/r2.ts via the r2(key) helper. The PUBLIC_ prefix is
# required so the value reaches the browser (HomeApp is a client:load island).
#
# Dev/testing (current): the bucket's rate-limited *.r2.dev endpoint.
#   Find it in the Cloudflare dashboard: R2 → your bucket → Settings →
#   Public Development URL (enable "Allow Access").
PUBLIC_R2_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev

# Production (TODO): once DNS is behind Cloudflare, bind a custom domain and
# use it instead — e.g.
# PUBLIC_R2_BASE_URL=https://cdn.mushogenshin.com
