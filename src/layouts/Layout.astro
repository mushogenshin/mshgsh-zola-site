---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * Tailwind background class for `<body>`. Defaults to the site paper (`bg-paper`
   * = #f4f1ea). The Work Detail page overrides it with the mock's slightly darker
   * cream (`bg-[#e9e4d8]`) so its paper-colored page card reads as a distinct
   * sheet lifted off the background rather than blending in.
   */
  bg?: string;
}

const {
  title = "Hoan Nguyen — Mushōgenshin",
  description = "Operating greatly in the realm between Art and Programming.",
  bg = "bg-paper",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Gaegu:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={`${bg} text-ink font-sans antialiased`}>
    <slot />
  </body>
</html>
