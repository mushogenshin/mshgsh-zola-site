---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import HomeApp from "../components/HomeApp";
import TeslaDefs from "../components/TeslaDefs.astro";
import Footer from "../components/Footer.astro";
import { parseTimelineYear, type ThroughlineEvent } from "../config/throughline";
import type { WorkItem } from "../config/gallery";

// Load the Throughline timeline from its YAML content collection at build time
// and hand it to the interactive island as plain, serializable data. getCollection
// orders entries by id (not YAML position), so we sort chronologically by year —
// the file can be authored in any order. The island derives each entry's side.
const throughline = (await getCollection("throughline"))
  // carry the collection entry id onto the data — the island uses it as the React
  // key and the FLIP row key so animated reflow can track rows across toggles. Drop
  // the heavy `detail` payload (only `/thread/{slug}` pages read it) but keep its
  // `slug` as `threadSlug`, so a Home card can link to its moment page when one exists.
  .map((entry) => {
    const { detail, ...rest } = entry.data;
    // Conditional spread so entries without a thread page carry no `threadSlug` key
    // at all (rather than a serialized `undefined`) — keeps the island props lean.
    return {
      ...rest,
      id: entry.id,
      ...(detail?.slug ? { threadSlug: detail.slug } : {}),
    } as ThroughlineEvent;
  })
  .sort(
    (a, b) =>
      parseTimelineYear(a.year) - parseTimelineYear(b.year) || (a.order ?? 0) - (b.order ?? 0),
  );

// Gallery tiles — same pattern. getCollection returns id order, so sort by `meter`
// (art→code) with an optional `order` tiebreaker. The id-merge is mandatory: the
// island keys tiles (React key, electric-current lookup, cull sets) by `it.id`, and
// the file() loader keeps id as the entry key, not in entry.data. Keep this array
// built here (build-time, one stable identity) — never inline it in re-rendering JSX,
// or the island's memoized electric-current veins would regenerate every render.
const gallery = (await getCollection("gallery"))
  .map((entry) => ({ ...entry.data, id: entry.id }) as WorkItem)
  .sort((a, b) => a.meter - b.meter || (a.order ?? 0) - (b.order ?? 0));
---

<Layout>
  {/* Global SVG filter defs + flicker keyframes for the tile electric-current meters. */}
  <TeslaDefs />
  <div class="max-w-[1160px] mx-auto px-[28px] pb-20 max-[600px]:px-4">
    <HomeApp client:load throughline={throughline} gallery={gallery} />
    <Footer />
  </div>
</Layout>
